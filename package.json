{
  "name": "ramen-go-api",
  "version": "1.1.0",
  "description": "",
  "main": "index.js",
  "homepage": "",
  "repository": "https://github.com/Robson16/ramen-go-api",
  "author": "Robson H. Rodrigues <robhenrod@gmail.com>",
  "license": "MIT",
  "keywords": [
    "NodeJS",
    "NestJS",
    "TypeScript",
    "ViTest"
  ],
  "scripts": {
    "migrate": "npx prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/infra/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts",
    "test:e2e:watch": "vitest --config ./vitest.config.e2e.mts",
    "release": "commit-and-tag-version"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "dayjs": "1.11.21",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.76",
    "zod-validation-error": "3.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "8.4.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@prisma/config": "7.9.1",
    "@swc/core": "1.15.47",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "4.17.25",
    "@types/multer": "1.4.13",
    "@types/node": "20.19.43",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "commit-and-tag-version": "13.1.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "source-map-support": "0.5.21",
    "supertest": "6.3.4",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.10"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
