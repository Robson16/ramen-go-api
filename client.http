@baseUrl = http://localhost:3333

### ========================================
### 👤 CONTAS E AUTENTICAÇÃO (ACCOUNTS)
### ========================================

# @name register_user
POST {{baseUrl}}/accounts
Content-Type: application/json

{
  "name": "Robson",
  "email": "robson@example.com",
  "password": "password123"
}

###

# @name login
POST {{baseUrl}}/sessions
Content-Type: application/json

{
  "email": "robson@example.com",
  "password": "password123"
}

###
# 🔥 Esta variável captura magicamente o token JWT da requisição 'login' acima!
@authToken = {{login.response.body.access_token}}
###

# @name admin_login
POST {{baseUrl}}/sessions
Content-Type: application/json

{
  "email": "admin@ramengo.com",
  "password": "admin123"
}

###
@adminAuthToken = {{admin_login.response.body.access_token}}
###

# @name get_profile
GET {{baseUrl}}/profile
Authorization: Bearer {{authToken}}

###

# @name edit_profile
PUT {{baseUrl}}/profile
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "Robson Henrique Rodrigues"
}

###

# @name forgot_password
POST {{baseUrl}}/password/forgot
Content-Type: application/json

{
  "email": "robson@example.com"
}

###

# @name reset_password
PATCH {{baseUrl}}/password/reset
Content-Type: application/json

{
  "token": "COLE_O_TOKEN_AQUI_DO_SEU_TERMINAL",
  "password": "new_secure_password_123"
}

###

# @name delete_profile
DELETE {{baseUrl}}/profile
Authorization: Bearer {{authToken}}


### ========================================
### 📸 IMAGENS (Protegido)
### ========================================

# @name upload_image
POST {{baseUrl}}/images
Content-Type: multipart/form-data; boundary=boundary123
Authorization: Bearer {{adminAuthToken}}

--boundary123
Content-Disposition: form-data; name="file"; filename="sample-upload.svg"
Content-Type: image/svg+xml

< ./test/e2e/sample-upload.svg
--boundary123--


### ========================================
### 🍲 CALDOS (BROTHS)
### ========================================

# @name create_broth
POST {{baseUrl}}/broths
Content-Type: application/json
Authorization: Bearer {{adminAuthToken}}

{
  "name": "Tonkotsu",
  "description": "Pork bone broth, boiled for hours for a rich, creamy flavor.",
  "price": 10,
  "imageActiveId": "3ebe8944-1f98-46f3-8811-0da7588f2d00",
  "imageInactiveId": "37505e8c-f3f0-4c7c-88e3-9d6cb91a7a74"
}

###

# @name list_broth
GET {{baseUrl}}/broths
Authorization: Bearer {{authToken}}


### ========================================
### 🥩 PROTEÍNAS (PROTEINS)
### ========================================

# @name create_protein
POST {{baseUrl}}/proteins
Content-Type: application/json
Authorization: Bearer {{adminAuthToken}}

{
  "name": "Chasu",
  "description": "A sliced flavourful pork meat with a selection of season vegetables.",
  "price": 10,
  "imageActiveId": "f6bd097c-126e-479d-908f-e3f7c0c0826e",
  "imageInactiveId": "453c15b2-c02a-4bb0-8352-7dd0adbd9ff0"
}

###

# @name list_protein
GET {{baseUrl}}/proteins
Authorization: Bearer {{authToken}}


### ========================================
### 🍜 PEDIDOS (ORDERS) (Protegido)
### ========================================

# @name create_order
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "brothId": "b8e0b0e0-0e0e-4e0e-8e0e-0e0e0e0e0e0e",
  "proteinId": "e1a3e3b3-3b3b-4b3b-8b3b-3b3b3b3b3b3b"
}

###

# @name get_order
# Pega o ID gerado automaticamente da requisição 'create_order' acima
@orderId = {{create_order.response.body.id}}

GET {{baseUrl}}/orders/{{orderId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}


### ========================================
### 👑 ADMINISTRAÇÃO
### ========================================

# @name list_users
GET {{baseUrl}}/admin/users
Authorization: Bearer {{adminAuthToken}}