@baseUrl = http://localhost:3333
@apiKey = K3q1IssTe1qIEgfTqFvVmqB6Knzeqll9EB76bhyyM6jf3C96siq9Tr7Cf16EPZ08

### ========================================
### 📸 IMAGENS
### ========================================

# @name upload_image
POST {{baseUrl}}/images
Content-Type: multipart/form-data; boundary=boundary123
x-api-key: {{apiKey}}

--boundary123
Content-Disposition: form-data; name="file"; filename="sample-upload.svg"
Content-Type: image/svg+xml

< ./test/e2e/sample-upload.svg
--boundary123--


### ========================================
### 🍲 CALDOS (BROTHS)
### ========================================

# @name create_broth
POST {{baseUrl}}/broths
Content-Type: application/json
x-api-key: {{apiKey}}

{
  "name": "Tonkotsu",
  "description": "Pork bone broth, boiled for hours for a rich, creamy flavor.",
  "price": 10,
  "imageActiveId": "3ebe8944-1f98-46f3-8811-0da7588f2d00",
  "imageInactiveId": "37505e8c-f3f0-4c7c-88e3-9d6cb91a7a74"
}

###

# @name list_broth
GET {{baseUrl}}/broths
Content-Type: application/json
x-api-key: {{apiKey}}


### ========================================
### 🥩 PROTEÍNAS (PROTEINS)
### ========================================

